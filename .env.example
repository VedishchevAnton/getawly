# App
APP_NAME=Getawly
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:8088

# Database (docker-compose defaults)
DATABASE_URL=postgresql+asyncpg://getawly:getawly@postgres:5432/getawly

# Session cookie
SESSION_COOKIE_NAME=getawly_session
SESSION_MAX_AGE=1209600

# Подписка
TRIAL_DAYS=30
SUBSCRIPTION_PRICE_RUB=100
SUBSCRIPTION_PERIOD_DAYS=30

# Платежи: stub (разработка) | manual (перевод по СБП) | yookassa
PAYMENT_PROVIDER=stub
MANUAL_PAYMENT_DETAILS=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Кто подтверждает ручные платежи, через запятую
ADMIN_EMAILS=

# After cloudflared/ngrok starts, put the https URL here, then:
#   docker compose up -d api
# Example:
# BASE_URL=https://xxxx.trycloudflare.com
